---
import '@fontsource-variable/literata';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { NAME, TAGLINE, DESCRIPTION, SITE_URL, REPO_URL, CONTACT_EMAIL, CREATOR, HASHTAG } from '../site';
import { repoStats, compact, SHOW_STARS_FROM } from '../lib/github';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${NAME}` : `${NAME}: ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const stats = await repoStats();
const stars = stats && stats.stars >= SHOW_STARS_FROM ? compact(stats.stars) : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, url: `${SITE_URL}/`, name: NAME, description: DESCRIPTION, inLanguage: 'en' },
    {
      '@type': 'SoftwareSourceCode',
      name: NAME,
      description: DESCRIPTION,
      url: `${SITE_URL}/`,
      codeRepository: REPO_URL,
      license: 'https://opensource.org/licenses/MIT',
      isAccessibleForFree: true,
      author: { '@id': `${SITE_URL}/#creator` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#creator`,
      name: CREATOR.name,
      url: `https://github.com/${CREATOR.github}`,
      sameAs: [`https://github.com/${CREATOR.github}`, `https://x.com/${CREATOR.x}`],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A Kindle showing a grid of big buttons, next to the words: Any screen can be a Stream Deck." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={`@${CREATOR.x}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Prompts for AI agents" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label={`${NAME}, home`}>
          <svg viewBox="0 0 26 26" aria-hidden="true">
            <rect x="1" y="1" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="9.5" y="1" width="7" height="7" rx="1.8" fill="currentColor" />
            <rect x="18" y="1" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="1" y="9.5" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="9.5" y="9.5" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="18" y="9.5" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="1" y="18" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="9.5" y="18" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="18" y="18" width="7" height="7" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.8" />
          </svg>
          streamdeckify
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#how">How it works</a>
          <a href="/#prompts">Prompts</a>
          <a href="/devices/">Devices</a>
          <a href="/#wall">The wall</a>
          <a class="gh" href={REPO_URL}><Icon name="github" /> GitHub{stars && <span class="count" aria-label={`${stars} stars`}>★ {stars}</span>}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <p>
            <b>{NAME}</b> is free and open source (MIT). Made by <a href={`https://x.com/${CREATOR.x}`}>{CREATOR.name}</a>
            and <a href={`${REPO_URL}/graphs/contributors`}>everyone who sent a pull request</a>.
          </p>
          <p class="legal">
            Independent community project. Not affiliated with, endorsed by or sponsored by Elgato or Corsair.
            Stream Deck is a trademark of Corsair Memory, Inc. Kindle is a trademark of Amazon.com, Inc. or its
            affiliates. Other names belong to their owners and are used only to describe what this project does.
            Jailbreaking can void your warranty; you are responsible for your own devices. Concerns, legal or
            otherwise? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we will answer quickly.
          </p>
        </div>
        <div>
          <p class="links">
            <a href={REPO_URL}>GitHub</a>
            <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Contribute</a>
            <a href="/devices/">Devices</a>
            <a href="/press/">Press kit</a>
            <a href="/llms.txt">llms.txt</a>
            <a href={`https://x.com/hashtag/${HASHTAG}`}>#{HASHTAG}</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
